# Import the Terraform plan
import "tfplan/v2" as tfplan

# Parameters
param valid_instance_types default ["t3.micro", "t3.small", "t3.medium"]

## Rules

# Validate instance type
validate_instance_type = rule {
	tfplan.variables.instance_type.value in valid_instance_types
	}


# Main rule to validate instance type
main = rule {
	validate_instance_type
}
